/* voice.rcss - the team-voice speaker list and the local mute badge.

   The list is pinned to the right edge above the ammo readout, and rows slide
   in from the right: a new speaker enters from off-list (translateX) while
   fading in, so a talk burst reads as players joining a queue instead of
   blinking on. RmlUi (re)starts an animation whenever the computed
   `animation` value changes, and the panel never touches that property after
   a row is appended, so every row plays this exactly once.

   The badge opens as icon + text when the voice state turns off, then (after
   a few seconds, driven by the module) collapses to the translucent icon:
   the width transition retracts the text to the right while it fades, and the
   plate drops away. */

#voice {
	position: absolute;
	right: 18dp;
	bottom: 78dp;
	width: auto;
	height: auto;
}

#voice-list {
	display: block;
	width: auto;
	height: auto;
}

@keyframes voice-row-enter {
	from {
		transform: translateX(26dp);
		opacity: 0;
	}
	to {
		transform: translateX(0dp);
		opacity: 1;
	}
}

.voice-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	width: auto;
	min-width: 96dp;
	margin-top: 2dp;
	padding: 2dp 8dp 2dp 3dp;
	background-color: #0000006b;
	border-radius: 3dp;
	animation: voice-row-enter 0.20s cubic-out;
}

.voice-avatar {
	width: 20dp;
	height: 20dp;
	margin-right: 7dp;
	border-radius: 2dp;
	image-color: #ffffff;
}

.voice-name {
	font-family: Verdana;
	font-size: 9.6dp;
	color: #e8e8e8;
	white-space: nowrap;
}

/* Local status badge. Expanded: icon + state text on the HUD plate.
   Collapsed (.collapsed): the plate fades out, the width shrinks to the icon
   and the text retracts to the right, leaving a semi-transparent glyph. */
#voice-badge {
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	width: 132dp;
	height: 22dp;
	padding: 0 6dp 0 4dp;
	margin-top: 2dp;
	overflow: hidden;
	background-color: #0000006b;
	border-radius: 3dp;
	transition: width 0.32s cubic-out, background-color 0.30s linear-in,
		opacity 0.30s linear-in;
}

#voice-badge.collapsed {
	width: 22dp;
	padding: 0 4dp;
	background-color: transparent;
	opacity: 0.55;
}

#voice-badge-icon {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.voice-badge-icon {
	width: 14dp;
	height: 14dp;
	image-color: #ffb000;
}

#voice-badge-text {
	margin-left: 6dp;
	font-family: Verdana;
	font-size: 8.6dp;
	color: var(--abc-hud-accent);
	white-space: nowrap;
	transition: opacity 0.20s linear-in, transform 0.32s cubic-out;
}

#voice-badge.collapsed #voice-badge-text {
	opacity: 0;
	transform: translateX(52dp);
}
