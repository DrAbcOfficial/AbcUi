/* spectator.rcss - observer bottom bar. The native panel is a dark plate with
   three bordered cells (health, armor, mode : target) anchored bottom-left;
   the replacement keeps that geometry in dp and uses the HUD accent for the
   values. When no target is shown the two vital cells are display:none and
   the mode cell stretches across the bar. */

/* The body itself must fill the document: its only child is absolutely
   positioned, so an auto-sized body would collapse to 0x0 and clip the bar
   away entirely (the same full-screen body rule the other HUD panels use). */
#spectator {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* The bar is the replacement's own surface: a translucent plate that reads
   over the scene. It is NOT a cover - the native SpectatorPanel is hidden by
   the paint gate (rmlui/PaintGate.cpp) while this document is visible, so no
   native pixel needs masking. 39dp is the native strip's 26 YRES units
   expressed in dp (both scale with screen height), kept so the replacement
   occupies the same band. */
#spectator-bar {
	position: absolute;
	left: 0;
	width: 100%;
	bottom: 0;
	height: 39dp;
	display: flex;
	flex-direction: row;
	align-items: stretch;
	background-color: #0c1017d9;
	border-top: 1dp #3b3a22;
}

.spec-cell {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 100%;
	padding: 0 10dp;
	border-right: 1dp #3b3a22;
	white-space: nowrap;
}

#spec-mode {
	flex: 1 1 auto;
	min-width: 0;
	border-right: 0dp;
}

.spec-vital {
	flex: 0 0 auto;
}

#spec-health {
	min-width: 96dp;
}

#spec-armor {
	min-width: 88dp;
}

.spec-label {
	font-family: Verdana;
	font-size: 8.9dp;
	color: #c8c8c8;
	opacity: 0.8;
	margin-right: 6dp;
}

.spec-value {
	font-family: Verdana;
	font-weight: bold;
	font-size: 10.7dp;
	color: var(--abc-hud-accent);
	white-space: nowrap;
	overflow: hidden;
}

#spec-mode .spec-value {
	color: #e8e8e8;
}
