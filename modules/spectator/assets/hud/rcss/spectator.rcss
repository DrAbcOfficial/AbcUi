/* spectator.rcss - observer readout in the classic HUD language.

   The native SpectatorPanel is suppressed by the paint gate, so this bar is
   the only observer surface: no cover plate, just the HUD's own bottom band.
   Left: the observed target's health and armor in the amber vital type
   (Verdana bold with the same 1px outline as the health readout). Right: the
   camera mode and the target name. When the observer has no target the vitals
   hide and the mode keeps the bar. */

#spectator {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#spectator-bar {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 38dp;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	padding: 0 18dp;
	background-color: #05070bd0;
	border-top: 1dp var(--abc-hud-accent-faint);
}

#spec-vitals {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 100%;
}

.spec-vital {
	display: flex;
	flex-direction: row;
	align-items: baseline;
}

.spec-divider {
	width: 1dp;
	height: 14dp;
	margin: 0 12dp;
	background-color: #ffffff26;
}

.spec-label {
	font-family: Verdana;
	font-size: 8.2dp;
	letter-spacing: 0.6dp;
	color: #aab2bc;
	margin-right: 6dp;
}

.spec-value {
	font-family: Verdana;
	font-weight: bold;
	font-size: 18dp;
	letter-spacing: 0.4dp;
	color: var(--abc-hud-accent);
	white-space: nowrap;
	font-effect: outline(1px #000000c8);
}

#spec-mode {
	display: flex;
	flex-direction: row;
	align-items: center;
	min-width: 0;
}

.spec-mode-text {
	font-family: Verdana;
	font-size: 9.6dp;
	color: #e8e8e8;
	white-space: nowrap;
	overflow: hidden;
}
