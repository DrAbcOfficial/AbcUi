<rml>
<head>
	<link type="text/rcss" href="mod://abcui.base/rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/spectator.rcss"/>
</head>
<body id="spectator">
	<!-- Observer readout in the shared HUD language: the target's vitals on
	     the left in the amber vital type, the camera mode and target name on
	     the right. The native SpectatorPanel is suppressed, so this bar is the
	     only observer surface and carries no cover styling. -->
	<div id="spectator-bar">
		<div id="spec-vitals">
			<div id="spec-health" class="spec-vital">
				<span id="spec-health-label" class="spec-label">Health</span>
				<span id="spec-health-value" class="spec-value">0</span>
			</div>
			<div class="spec-divider"></div>
			<div id="spec-armor" class="spec-vital">
				<span id="spec-armor-label" class="spec-label">Armor</span>
				<span id="spec-armor-value" class="spec-value">0</span>
			</div>
		</div>
		<div id="spec-mode">
			<span id="spec-mode-value" class="spec-mode-text">Spectator</span>
		</div>
	</div>
</body>
</rml>
