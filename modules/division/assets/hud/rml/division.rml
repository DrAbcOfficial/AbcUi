<rml>
<head>
	<link type="text/rcss" href="mod://abcui.base/rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/division.rcss"/>
</head>
<body id="division">
	<!-- The Division-style cluster: one compact plate at the character's hip,
	     carried as a unit by DivisionModule.

	     Top: a white segmented health bar with its value, a thinner orange
	     armour bar with its value. Cells are appended by the module (one per
	     10 points of the tracked maximum), so the RML only provides the two
	     containers.

	     Ammo: one row per ammo type - the type's sprite, its magazine (large)
	     and its reserve (small). A weapon with a second, different ammo type
	     gets a second row with its own sprite; the flashlight battery and the
	     longjump module state sit to the right of the first row. -->
	<div id="cluster">
		<div id="plate"></div>
		<div id="edge"></div>

		<div id="health-cells"></div>
		<div id="health-value" class="big right">0</div>

		<div id="armor-cells"></div>
		<div id="armor-value" class="small right">0</div>

		<div id="ammo-row1">
			<img id="ammo-icon" class="icon"/>
			<div id="clip1" class="big">0</div>
			<div id="ammo1" class="small">0</div>
		</div>

		<div id="ammo-row2">
			<img id="ammo2-icon" class="icon"/>
			<div id="clip2" class="big">0</div>
			<div id="ammo2" class="small">0</div>
		</div>

		<div id="flash-battery">
			<div id="flash-fill" class="fill"></div>
		</div>
		<div id="flash-value" class="tiny">100%</div>

		<div id="longjump" class="tiny right">LJ</div>
	</div>
</body>
</rml>
