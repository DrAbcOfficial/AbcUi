/* division.rcss - the Division-style third-person cluster.

   One compact plate at the character's hip (the module moves #cluster in px
   from the projected player origin; every box here is dp):

     top     white segmented health bar (7dp) and its value
             orange segmented armour bar (3dp) and its value
     ammo    one row per ammo type: sprite, magazine (large), reserve (small);
             the flashlight battery and the longjump state ride the right

   The bars keep a fixed length; their cell count follows the tracked maximum
   (10 points per cell) and the module positions the cells, so a 150 HP or an
   80 HP maximum still fills the bar and the last cell can be partial. The
   backing stays at 15% opacity (it must not block the view); legibility comes
   from near-white ink with a 1px black outline. No image or font asset ships
   with the group. */

#division {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#cluster {
	position: absolute;
	left: 0;
	top: 0;
	width: 150dp;
	height: 40dp;
	/* The third-person lean pivots at the edge nearest the character. */
	transform-origin: 100% 50%;
}

#plate {
	position: absolute;
	left: 0;
	top: 0;
	width: 150dp;
	height: 40dp;
	background-color: #0b0e1226;
	border-radius: 2dp;
}

/* The one accent: a 2dp amber edge on the plate's left side. */
#edge {
	position: absolute;
	left: 0;
	top: 4dp;
	width: 2dp;
	height: 32dp;
	background-color: var(--abc-hud-accent);
	opacity: 0.8;
}

.big {
	position: absolute;
	font-family: Verdana;
	font-weight: bold;
	font-size: 11dp;
	line-height: 15dp;
	letter-spacing: 0.1dp;
	color: #f5f7f8;
	opacity: 0.95;
	font-effect: outline(1px #000000b8);
}

.small {
	position: absolute;
	font-family: Verdana;
	font-weight: normal;
	font-size: 8dp;
	line-height: 10dp;
	color: #e4eaee;
	opacity: 0.9;
	font-effect: outline(1px #000000a8);
}

.tiny {
	position: absolute;
	font-family: Verdana;
	font-weight: normal;
	font-size: 8dp;
	line-height: 10dp;
	color: #d8dfe4;
	opacity: 0.85;
	font-effect: outline(1px #000000a0);
}

.right {
	text-align: right;
}

/* Segmented bars: the empty cell (track) plus its fill. The module sets each
   cell's left/width and each fill's width; everything else is fixed here. */
#health-cells {
	position: absolute;
	left: 6dp;
	top: 1dp;
	width: 112dp;
	height: 7dp;
}

#health-cells .cell {
	position: absolute;
	top: 0;
	height: 7dp;
	background-color: #ffffff2e;
	border-radius: 1dp;
}

#health-cells .cell .fill {
	position: absolute;
	left: 0;
	top: 0;
	height: 7dp;
	background-color: #ffffff;
	border-radius: 1dp;
	opacity: 0.95;
}

#armor-cells {
	position: absolute;
	left: 6dp;
	top: 9dp;
	width: 112dp;
	height: 3dp;
}

#armor-cells .cell {
	position: absolute;
	top: 0;
	height: 3dp;
	background-color: #ffb00026;
	border-radius: 1dp;
}

#armor-cells .cell .fill {
	position: absolute;
	left: 0;
	top: 0;
	height: 3dp;
	background-color: var(--abc-hud-accent);
	border-radius: 1dp;
	opacity: 0.95;
}

#health-value {
	left: 122dp;
	top: 0;
	width: 22dp;
	height: 9dp;
	font-size: 9dp;
	line-height: 9dp;
}

#armor-value {
	left: 122dp;
	top: 9dp;
	width: 22dp;
	height: 9dp;
	font-size: 8dp;
	line-height: 9dp;
}

/* Ammo rows: the sprite sits flush against the magazine, the reserve follows
   in the small type. The module shows the second row only for a weapon with a
   second magazine or a distinct secondary ammo type, and centres the single
   row when it is alone. */
#ammo-row1,
#ammo-row2 {
	position: absolute;
	left: 0;
	width: 150dp;
	height: 12dp;
}

#ammo-row1 {
	top: 20dp;
}

#ammo-row2 {
	top: 26dp;
}

#ammo-row1 .icon,
#ammo-row2 .icon {
	position: absolute;
	left: 6dp;
	top: 2dp;
	width: 9dp;
	height: 9dp;
	image-color: #eef3f6;
	opacity: 0.9;
}

#ammo-row1 .big,
#ammo-row2 .big {
	left: 18dp;
	top: 0;
	width: 24dp;
	height: 12dp;
	font-size: 11dp;
	line-height: 12dp;
}

#ammo-row1 .small,
#ammo-row2 .small {
	left: 44dp;
	top: 2dp;
	width: 16dp;
	height: 10dp;
}

/* Flashlight battery and percentage, on the first ammo row's line. */
#flash-battery {
	position: absolute;
	left: 82dp;
	top: 27dp;
	width: 12dp;
	height: 3dp;
	background-color: #0000003d;
	border-radius: 1dp;
}

#flash-battery .fill {
	position: absolute;
	left: 0;
	top: 0;
	width: 0;
	height: 3dp;
	background-color: var(--abc-hud-accent);
	border-radius: 1dp;
	opacity: 0.9;
}

#flash-value {
	left: 96dp;
	top: 22dp;
	width: 22dp;
	height: 10dp;
}

/* Longjump module state: the backpack mark, tinted amber, only shown while
   the module is owned. */
#longjump {
	position: absolute;
	left: 128dp;
	top: 22dp;
	width: 12dp;
	height: 12dp;
	image-color: var(--abc-hud-accent);
	opacity: 0.9;
}
