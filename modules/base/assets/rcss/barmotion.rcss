/* barmotion.rcss - shared smooth state for HUD value bars (issue #30,
   moduleui::barmotion). Linked by the panels whose readouts fill a bar; the
   module writes the classes, this sheet owns the timing.

   A bar box carries .bar-motion plus exactly one direction class per write:
     .bar-drop  the value fell, a 0.12s cubic ramp (damage reads instantly)
     .bar-gain  the value rose, a 0.30s cubic ramp (healing reads as a fill)
     .bar-snap  no transition at all (first show, re-show, reset)
   The fill itself carries .bar-fill-N, its width as a percentage of its own
   box. Percentages are what make the segmented bar's relayout inert: when the
   maximum changes, only the cells' dp left/width move, the class - and so the
   percentage - stays, and nothing on the strip animates.

   RCSS transitions fire on definition changes only, which is why the width is
   a class rather than an inline length. The box's direction class and the
   fill's width class are set in the same frame; RmlUi picks the transition up
   from the new definition. */

/* A fill that is the box itself (the classic vitals meter) and the fills of a
   segmented box are both covered. */
.bar-motion,
.bar-motion .fill {
	transition: width 0.30s cubic-out;
}

.bar-motion.bar-drop,
.bar-motion.bar-drop .fill {
	transition: width 0.12s cubic-out;
}

.bar-motion.bar-gain,
.bar-motion.bar-gain .fill {
	transition: width 0.30s cubic-out;
}

.bar-motion.bar-snap,
.bar-motion.bar-snap .fill {
	transition: none;
}

/* Width ladder: one class per percent of the fill's box. Generated; keep it
   in step with barmotion::kSteps. */
.bar-fill-0 { width: 0%; }
.bar-fill-1 { width: 1%; }
.bar-fill-2 { width: 2%; }
.bar-fill-3 { width: 3%; }
.bar-fill-4 { width: 4%; }
