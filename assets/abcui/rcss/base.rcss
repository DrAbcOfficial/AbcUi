/* base.rcss - shared HUD theme (fonts, colours, vars). Plan 05 §4.3.
   hud_size / hud_alpha knobs land with batch A; Phase 3 pins the baseline. */

@font-face {
	font-family: "Microsoft YaHei";
	src: local("Microsoft YaHei");
	font-weight: normal;
}
@font-face {
	font-family: "Microsoft YaHei";
	src: local("Microsoft YaHei Bold");
	font-weight: bold;
}
@font-face {
	font-family: "Consolas";
	src: local("Consolas");
}

body {
	font-family: "Microsoft YaHei";
	font-size: 16px;
	color: #e8e8e8;
}
