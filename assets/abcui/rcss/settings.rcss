/* settings.rcss - T10 settings page, T11 key-bind section. Layout in dp
   only (context density ratio scales); element defaults are explicit
   because RmlUi ships no user-agent stylesheet. Shared panel/button styling
   comes from mainmenu.rcss (same #panel frame and button rules). */

/* The viewport is 480dp tall at the production density. Reserve room for
   a separate two-row footer. Border-box includes the inherited padding and
   border; the old content-box height extended underneath the action bar. */
body#menusettings #panel {
	box-sizing: border-box;
	width: 374dp;
	height: 356dp;
	overflow: auto;
}

/* RmlUi builds its scrollbar elements without any user-agent styles: they
   need explicit layout or the unstyled sliderbar overlays the content and
   swallows every click (live-caught: the bind buttons were unreachable).
   The sample pattern: a zero-width positioned container whose thin bar
   juts out to the left with negative margin. */
body#menusettings #panel scrollbarvertical {
	z-index: 100;
	width: 0dp;
}
body#menusettings #panel scrollbarvertical sliderbar {
	margin-left: -10dp;
	width: 10dp;
	min-height: 24dp;
	background-color: #3a4148;
}
body#menusettings #panel scrollbarvertical sliderbar:hover,
body#menusettings #panel scrollbarvertical sliderbar:active {
	background-color: #55606c;
}

#settings-status {
	display: block;
	font-size: 9dp;
	color: #8a9199;
	height: 14dp;
	line-height: 14dp;
	margin-bottom: 10dp;
}

#rows {
	display: block;
	width: 340dp;
}

/* One description-table row per block: label, control, status line. */
.row {
	display: block;
	margin-bottom: 10dp;
}

.row-label {
	display: block;
	font-size: 10dp;
	color: #e8e8e8;
	margin-bottom: 4dp;
}

.row-input {
	display: inline-block;
	box-sizing: border-box;
	width: 336dp;
	height: 24dp;
	line-height: 22dp;
	background-color: #0a0d10;
	color: #dedede;
	font-size: 10dp;
	padding: 0dp 6dp;
	border: 1dp #3a4148;
	tab-index: auto;
	white-space: nowrap;
}

.row-input:focus {
	border: 1dp #00ff00;
	background-color: #0e1418;
}

.row-input caret {
	display: inline-block;
	background-color: #e8e8e8;
}

.row-toggle {
	display: inline-block;
	width: auto;
	min-width: 64dp;
	height: 24dp;
	line-height: 24dp;
	text-align: center;
	background-color: #1c2329;
	color: #e8e8e8;
	font-size: 10dp;
	border: 1dp #3a4148;
	tab-index: auto;
}

.row-toggle:hover {
	background-color: #232b32;
}

.row-toggle:focus {
	background-color: #144d14;
	border: 1dp #00ff00;
	color: #ffffff;
}

.row-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-top: 2dp;
}

/* Unavailable rows (cvar not registered): greyed, still readable. */.row-missing {
	color: #6a7178;
	opacity: 0.6;
}

/* T11 key-binding section: scrollable action list (47 kb_act entries),
   one row per action with label, key list and bind/clear buttons. */
#bind-title {
	display: block;
	font-size: 12dp;
	color: #e8e8e8;
	margin: 14dp 0dp 6dp 0dp;
}

#bind-status {
	display: block;
	font-size: 9dp;
	color: #8a9199;
	height: 14dp;
	line-height: 14dp;
	margin-bottom: 6dp;
}

/* One scroll container only (the panel): a nested scroller inside the
   panel's scroll clipped its entire content on the live build. */
#bindrows {
	display: block;
	width: 336dp;
}

.bind-header {
	display: block;
	font-size: 9dp;
	color: #6a7178;
	margin: 8dp 0dp 4dp 0dp;
}

.bind-row {
	display: block;
	margin-bottom: 3dp;
}

.bind-line {
	display: block;
	height: 22dp;
	line-height: 22dp;
	white-space: nowrap;
	overflow: hidden;
}

.bind-label {
	display: inline-block;
	width: 150dp;
	font-size: 10dp;
	color: #e8e8e8;
	vertical-align: middle;
	white-space: nowrap;
	overflow: hidden; /* long labels clip, never bleed into the key column */
}

.bind-keys {
	display: inline-block;
	width: 80dp;
	font-size: 10dp;
	color: #7ec97e;
	vertical-align: middle;
	white-space: nowrap;
}

.bind-row.bind-capturing .bind-keys {
	color: #ffe08a;
}

.bind-btn {
	display: inline-block;
	width: auto;
	min-width: 46dp;
	height: 20dp;
	line-height: 18dp;
	text-align: center;
	background-color: #1c2329;
	color: #e8e8e8;
	font-size: 9dp;
	border: 1dp #3a4148;
	margin: 0dp 0dp 0dp 3dp; /* mainmenu button margin-bottom would stack here */
	vertical-align: middle;
	tab-index: auto;
	white-space: nowrap;
}

.bind-btn:hover {
	background-color: #232b32;
}

.bind-btn:focus {
	background-color: #144d14;
	border: 1dp #00ff00;
	color: #ffffff;
}

.bind-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-left: 144dp;
}

/* T12 video section. A projection of the video model; when the query
   interface is missing the block renders disabled (video-unavailable)
   instead of pretending controls work. */
#video-section {
	display: block;
	margin-top: 12dp;
}

#video-section .video-select {
	display: inline-block;
	width: 120dp;
}

#video-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-left: 144dp;
	margin-top: 4dp;
}

#video-actions {
	margin-top: 8dp;
	margin-left: 144dp;
}

#video-section.video-unavailable #video-status {
	color: #d8b45a;
}

#video-apply.video-disabled {
	color: #6f757c;
	border-color: #3a4047;
}

/* T13: section headers between the description-table groups (the table is
   grouped by the original Options pages), and the per-row enum selects. */
.section-header {
	display: block;
	font-size: 11dp;
	color: #9fd49f;
	margin-top: 14dp;
	margin-bottom: 8dp;
	border-bottom: 1dp #2c333a;
	padding-bottom: 2dp;
}

.row-select {
	display: inline-block;
	box-sizing: border-box;
	width: 200dp;
	height: 24dp;
	line-height: 22dp;
	background-color: #0a0d10;
	color: #dedede;
	font-size: 10dp;
	padding: 0dp 6dp;
	border: 1dp #3a4148;
	tab-index: auto;
}

/* T13 voice section: same frame as the video section; the test button and
   boost share the row-toggle look, the status line carries the live level
   readout (a plain number - no fake meter animation). */
#voice-section {
	display: block;
	margin-top: 12dp;
}

#voice-section .row-input {
	width: 200dp;
}

#voice-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-left: 144dp;
	margin-top: 4dp;
}

#voice-section.video-unavailable #voice-status {
	color: #d8b45a;
}

/* Explicit columns prevent auto-sized inline buttons from overflowing or
   wrapping Return below the viewport. Apply/Return are always on the first
   row, destructive default-reset entries on the second. Bottom = 468dp. */
#settings-actions {
	display: block;
	position: absolute;
	left: 48dp;
	top: 404dp;
	width: 374dp;
	height: 64dp;
	z-index: 1;
}

#settings-actions button {
	display: block;
	position: absolute;
	box-sizing: border-box;
	width: 179dp;
	height: 28dp;
	margin: 0dp;
	white-space: nowrap;
	overflow: hidden;
}
#settings-apply { left: 0dp; top: 0dp; }
#settings-return { right: 0dp; top: 0dp; }
#settings-reset { left: 0dp; top: 36dp; }
#bind-reset { right: 0dp; top: 36dp; }

/* Page-internal confirm layers are document-level overlays (direct children
   of the body, NOT of the scrollable panel - absolute layers inside the
   scroll container scroll away with the content). Hidden until the page
   turns the display property on (the layer member tracks the state - a
   SetProperty lands at the next layout frame). */
.settings-layer {
	display: none;
	position: absolute;
	z-index: 2;
	left: 48dp;
	top: 40dp;
	width: 372dp;
	min-height: 200dp;
	background-color: #101418f8;
	border: 1dp #3a4148;
	padding: 16dp;
}

.settings-layer p {
	display: block;
	font-size: 10dp;
	color: #dedede;
	margin-bottom: 12dp;
}

.settings-layer button {
	display: inline-block;
	margin-right: 8dp;
}
