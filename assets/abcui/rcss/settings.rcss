/* settings.rcss - T10 settings page, T11 key-bind section. Layout in dp
   only (context density ratio scales); element defaults are explicit
   because RmlUi ships no user-agent stylesheet. Shared panel/button styling
   comes from mainmenu.rcss (same #panel frame and button rules). */

/* The viewport is 480dp tall at the production density. Reserve room for
   a separate two-row footer. Border-box includes the inherited padding and
   border; the old content-box height extended underneath the action bar.
   The panel spans the full width between the page gutters instead of a
   fixed 374dp: its right edge sits 48dp from the viewport edge, matching
   the 48dp gutter left of the navigation column. The extra right padding
   leaves the scrollbar inside the panel with the same 8dp inset it had at
   the previous width, and keeps row content clear of the bar. */
body#menusettings #panel {
	box-sizing: border-box;
	left: 190dp;
	right: 48dp;
	width: auto;
	padding-right: 26dp;
	height: 356dp;
	overflow: auto;
}

#settings-navigation {
	position: absolute;
	left: 48dp;
	top: 40dp;
	width: 126dp;
	height: 356dp;
	overflow: auto;
}

#settings-navigation button.selected {
	background-color: var(--abc-surface-3);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-accent);
}

#settings-navigation button {
	display: block;
	box-sizing: border-box;
	width: 116dp;
	height: 30dp;
	line-height: 28dp;
	text-align: left;
	margin-bottom: 4dp;
}

.settings-cvar-page {
	display: block;
}

/* RmlUi builds its scrollbar elements without any user-agent styles: they
   need explicit layout or the unstyled sliderbar overlays the content and
   swallows every click (live-caught: the bind buttons were unreachable).
   The sample pattern: a zero-width positioned container whose thin bar
   juts out to the left with negative margin. */
body#menusettings #panel scrollbarvertical,
#settings-navigation scrollbarvertical {
	z-index: 100;
	width: 0dp;
}
body#menusettings #panel scrollbarvertical sliderbar,
#settings-navigation scrollbarvertical sliderbar {
	margin-left: -10dp;
	width: 10dp;
	min-height: 24dp;
	background-color: var(--abc-line);
}
body#menusettings #panel scrollbarvertical sliderbar:hover,
body#menusettings #panel scrollbarvertical sliderbar:active,
#settings-navigation scrollbarvertical sliderbar:hover,
#settings-navigation scrollbarvertical sliderbar:active {
	background-color: #55606c;
}

#settings-status {
	display: block;
	font-size: 9dp;
	color: #8a9199;
	height: 14dp;
	line-height: 14dp;
	margin-bottom: 10dp;
}

#rows {
	display: block;
	width: 340dp;
}

/* One description-table row per block: label, control, status line. */
.row {
	display: block;
	margin-bottom: 10dp;
}

.row-label {
	display: block;
	font-size: 10dp;
	color: #e8e8e8;
	margin-bottom: 4dp;
}

.row-input {
	display: inline-block;
	box-sizing: border-box;
	width: 336dp;
	height: 24dp;
	line-height: 22dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	font-size: 10dp;
	padding: 0dp 6dp;
	border: 1dp var(--abc-line);
	tab-index: auto;
	white-space: nowrap;
}

.row-input:focus {
	border: 1dp var(--abc-accent);
	background-color: #0e1418;
}

.row-input caret {
	display: inline-block;
	background-color: #e8e8e8;
}

.row-toggle {
	display: inline-block;
	width: auto;
	min-width: 64dp;
	height: 24dp;
	line-height: 24dp;
	text-align: center;
	background-color: #1c2329;
	color: #e8e8e8;
	font-size: 10dp;
	border: 1dp var(--abc-line);
	tab-index: auto;
}

.row-toggle:hover {
	background-color: #232b32;
}

.row-toggle:focus {
	background-color: var(--abc-accent-soft);
	border: 1dp var(--abc-accent);
	color: #ffffff;
}

.row-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-top: 2dp;
}

/* Unavailable rows (cvar not registered): greyed, still readable. */.row-missing {
	color: #6a7178;
	opacity: 0.6;
}

/* T11 key-binding section: scrollable action list (47 kb_act entries),
   one row per action with label, key list and bind/clear buttons. */
#bind-title {
	display: block;
	font-size: 12dp;
	color: #e8e8e8;
	margin: 14dp 0dp 6dp 0dp;
}

#bind-status {
	display: block;
	font-size: 9dp;
	color: #8a9199;
	height: 14dp;
	line-height: 14dp;
	margin-bottom: 6dp;
}

/* One scroll container only (the panel): a nested scroller inside the
   panel's scroll clipped its entire content on the live build. */
#bindrows {
	display: block;
	width: 336dp;
}

.bind-header {
	display: block;
	font-size: 9dp;
	color: #6a7178;
	margin: 8dp 0dp 4dp 0dp;
}

.bind-row {
	display: block;
	margin-bottom: 3dp;
}

.bind-line {
	display: block;
	height: 22dp;
	line-height: 22dp;
	white-space: nowrap;
	overflow: hidden;
}

.bind-label {
	display: inline-block;
	width: 150dp;
	font-size: 10dp;
	color: #e8e8e8;
	vertical-align: middle;
	white-space: nowrap;
	overflow: hidden; /* long labels clip, never bleed into the key column */
}

.bind-keys {
	display: inline-block;
	width: 80dp;
	font-size: 10dp;
	color: #7ec97e;
	vertical-align: middle;
	white-space: nowrap;
}

.bind-row.bind-capturing .bind-keys {
	color: #ffe08a;
}

.bind-btn {
	display: inline-block;
	width: auto;
	min-width: 46dp;
	height: 20dp;
	line-height: 18dp;
	text-align: center;
	background-color: #1c2329;
	color: #e8e8e8;
	font-size: 9dp;
	border: 1dp var(--abc-line);
	margin: 0dp 0dp 0dp 3dp; /* mainmenu button margin-bottom would stack here */
	vertical-align: middle;
	tab-index: auto;
	white-space: nowrap;
}

.bind-btn:hover {
	background-color: #232b32;
}

.bind-btn:focus {
	background-color: var(--abc-accent-soft);
	border: 1dp var(--abc-accent);
	color: #ffffff;
}

.bind-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-left: 144dp;
}

/* T12 video section. A projection of the video model; when the query
   interface is missing the block renders disabled (video-unavailable)
   instead of pretending controls work. */
#video-section {
	display: block;
	margin-top: 12dp;
}

#video-section .video-select {
	display: inline-block;
	width: 120dp;
}

#video-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-left: 144dp;
	margin-top: 4dp;
}

#video-actions {
	margin-top: 8dp;
	margin-left: 144dp;
}

#video-section.video-unavailable #video-status {
	color: #d8b45a;
}

#video-apply.video-disabled {
	color: #6f757c;
	border-color: #3a4047;
}

/* T13: section headers between the description-table groups (the table is
   grouped by the original Options pages), and the per-row enum selects. */
.section-header {
	display: block;
	font-size: 11dp;
	color: #9fd49f;
	margin-top: 14dp;
	margin-bottom: 8dp;
	border-bottom: 1dp #2c333a;
	padding-bottom: 2dp;
}

.row-select {
	display: inline-block;
	box-sizing: border-box;
	width: 200dp;
	height: 24dp;
	line-height: 22dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	font-size: 10dp;
	padding: 0dp 6dp;
	border: 1dp var(--abc-line);
	tab-index: auto;
}

/* T13 voice section: same frame as the video section; the test button and
   boost share the row-toggle look, the status line carries the live level
   readout (a plain number - no fake meter animation). */
#voice-section {
	display: block;
	margin-top: 12dp;
}

#voice-section .row-input {
	width: 200dp;
}

#voice-status {
	display: block;
	font-size: 8dp;
	color: #8a9199;
	margin-left: 144dp;
	margin-top: 4dp;
}

#voice-section.video-unavailable #voice-status {
	color: #d8b45a;
}

/* One flat row: Apply, Return and the page's default-reset entry share the
   bar (the key-binding reset joins them on the keyboard page, where the
   page entry is hidden). A flex line distributes them equally and never
   wraps, so no column can push Return below the viewport. The bar keeps
   the panel's left anchor and stretches to the same 48dp right gutter,
   and anchors to the bottom gutter so the footer holds its 48dp margin
   when a narrower window raises the logical viewport height. */
#settings-actions {
	display: flex;
	position: absolute;
	left: 190dp;
	right: 48dp;
	bottom: 48dp;
	width: auto;
	height: 28dp;
	z-index: 1;
}

#settings-actions button {
	display: block;
	box-sizing: border-box;
	flex: 1 1 0%;
	min-width: 0dp;
	width: auto;
	height: 28dp;
	margin: 0dp 0dp 0dp 10dp;
	white-space: nowrap;
	overflow: hidden;
}
#settings-actions button:first-child { margin-left: 0dp; }

/* The defaults entries preview their destructive effect on hover. Focus
   keeps the shared amber treatment (the theme sheet's :focus rule wins on
   hover-click). */
#settings-reset:hover, #bind-reset:hover {
	background-color: #3a1c1c;
	border-color: var(--abc-danger);
	color: var(--abc-danger);
}

/* Page-internal confirm layers are document-level overlays (direct children
   of the body, NOT of the scrollable panel - absolute layers inside the
   scroll container scroll away with the content). Hidden until the page
   turns the display property on (the layer member tracks the state - a
   SetProperty lands at the next layout frame).

   Every prompt shares the frame the quit confirmation shipped with: the
   same surface and hairline border with the amber top rule, the same
   fixed 372dp box, 16dp padding, 10dp left-aligned body text and a single
   left-aligned button row (confirmquit.rml carries this class on its
   panel, so that window now takes the shared definition instead of
   duplicating it). The layer rides above the action bar (z-index 1). */
.settings-layer {
	display: none;
	position: absolute;
	z-index: 2;
	left: 48dp;
	top: 40dp;
	width: 372dp; /* the panel width the prompt interrupts */
	min-height: 128dp;
	background-color: #101418f8;
	border: 1dp var(--abc-line);
	border-top: 2dp var(--abc-accent);
	padding: 16dp;
}

.settings-layer p {
	display: block;
	font-size: 10dp;
	color: var(--abc-text);
	margin-bottom: 12dp;
}

.settings-layer button {
	display: inline-block;
	width: auto;
	margin: 0dp 0dp 0dp 8dp;
}

.settings-layer button:first-child {
	margin-left: 0dp;
}

.bind-header { background-color: #303d49; padding: 5dp; margin: 10dp 0dp; color: #bce0f4; }
.bind-header-columns { display: block; font-size: 8dp; color: #a7b8c9; }
#multiplayer-previews { display: block; }
.preview-box { display: inline-block; width: 160dp; vertical-align: top; }
.preview-box img { display: block; width: 150dp; height: 170dp; background-color: #090d12; }
#model-preview {
	display: block;
	width: 150dp;
	height: 170dp;
	cursor: move;
}
#model-preview-hint {
	display: block;
	height: 12dp;
	line-height: 12dp;
	font-size: 7dp;
	color: var(--abc-text-dim);
}
#spray-preview { height: 150dp; }
#voice-meter { display: block; width: 280dp; height: 14dp; background-color: #171c24; border: 1dp #536071; margin: 8dp 0dp; }
#voice-meter-fill { display: block; width: 0%; height: 14dp; background-color: #68bd66; }
