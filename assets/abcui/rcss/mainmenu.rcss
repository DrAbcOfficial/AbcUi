/* mainmenu.rcss - T05 minimal interactive page. Layout in dp only: the
   context density ratio (framework::Theme::applyScale) does all scaling, so
   no pixel assumptions live here. RmlUi ships no user-agent stylesheet -
   every element gets its full display/tab/caret styling explicitly. */

/* ---- identity block ---------------------------------------------------- */

#menu-header {
	position: absolute;
	left: 26dp;
	top: 20dp;
	width: 300dp;
}

#menu-brand {
	display: block;
	font-size: 8dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: var(--abc-accent);
	margin-bottom: 2dp;
}

#title {
	display: block;
	font-size: 18dp;
	font-weight: bold;
	letter-spacing: 0.5dp;
	color: var(--abc-text-strong);
}

/* ---- entry column ------------------------------------------------------ */

#menu-nav {
	position: absolute;
	left: 26dp;
	top: 92dp;
	width: 236dp;
}

/* One entry row: a flat, left-aligned bar with an amber spine when focused -
   the GoldSrc list look, flattened for the modern shell. */
#page-main button, #page-pause button {
	display: block;
	width: 236dp;
	height: 26dp;
	line-height: 26dp;
	text-align: left;
	padding-left: 12dp;
	background-color: #111920cc;
	border-left: 2dp #2d3840;
	border-top: 1dp #1e262c;
	color: var(--abc-text);
	font-size: 10dp;
	letter-spacing: 0.4dp;
	tab-index: auto;
	margin-bottom: 4dp;
}

#page-main button:hover, #page-pause button:hover {
	background-color: #1b252bf2;
	color: var(--abc-text-strong);
}

#page-main button:focus, #page-pause button:focus {
	background-color: var(--abc-accent);
	border-left: 2dp var(--abc-accent);
	color: var(--abc-accent-ink);
	font-weight: bold;
}

#focus-status {
	display: block;
	font-size: 8dp;
	color: var(--abc-text-dim);
	height: 12dp;
	line-height: 12dp;
	margin-top: 6dp;
	padding-left: 2dp;
}

/* ---- side column: friends above the character -------------------------- */
/* Anchored to the RIGHT edge: the Rml logical screen is
   screenWidth / (screenHeight / 480) dp wide (768dp at 16:10, 853dp at 16:9),
   so a left coordinate would drift with the aspect ratio. */

#friends-panel {
	position: absolute;
	right: 26dp;
	top: 92dp;
	width: 218dp;
	max-height: 134dp;
	padding: 8dp;
	overflow: hidden;
}

#friends-list {
	display: block;
	max-height: 108dp;
	overflow-y: auto;
}

/* Friend rows: avatar, persona, state; right-click opens the join menu. */
.friend-row {
	position: relative;
	display: block;
	height: 26dp;
	line-height: 26dp;
	border-bottom: 1dp var(--abc-line-soft);
	background-color: transparent;
	color: var(--abc-text);
	font-size: 8dp;
	padding-left: 4dp;
	padding-right: 6dp;
}

.friend-row:hover {
	background-color: var(--abc-surface-3);
}

.friend-row.friend-self {
	color: var(--abc-accent);
}

.friend-row.friend-playing {
	color: var(--abc-ok);
}

.friend-avatar {
	display: inline-block;
	width: 18dp;
	height: 18dp;
	margin-right: 6dp;
	margin-top: 3dp;
	vertical-align: top;
}

.friend-name {
	display: inline-block;
	height: 24dp;
	line-height: 24dp;
	font-size: 8dp;
	width: 142dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.friend-state {
	position: absolute;
	right: 2dp;
	top: 0dp;
	display: inline-block;
	height: 24dp;
	line-height: 24dp;
	font-size: 7dp;
	float: right;
	color: var(--abc-text-dim);
}

#friends-empty {
	display: block;
	height: 96dp;
	line-height: 96dp;
	text-align: center;
	font-size: 8dp;
	color: var(--abc-text-dim);
}

/* Right-click menu for a friend row. */
#friend-menu {
	display: none;
	position: absolute;
	width: 116dp;
	background-color: #10161af8;
	border: 1dp var(--abc-line);
	padding: 2dp;
}

.friend-menu-entry {
	display: block;
	height: 20dp;
	line-height: 20dp;
	font-size: 8dp;
	padding-left: 6dp;
	color: var(--abc-text);
}

.friend-menu-entry:hover {
	background-color: var(--abc-accent);
	color: var(--abc-accent-ink);
}

/* ---- character card ---------------------------------------------------- */

#player-card {
	position: absolute;
	right: 26dp;
	top: 232dp;
	width: 258dp;
	height: 216dp;
}

/* The live Studio preview; the Renderer draws it into its own FBO and the
   element presents it, so the box here is exactly what the camera frames. */
#player-model {
	display: block;
	width: 132dp;
	height: 176dp;
	margin-left: 63dp;
}

#player-strip {
	display: block;
	width: 258dp;
	height: 40dp;
	background-color: var(--abc-surface);
	border-top: 1dp var(--abc-line);
	border-left: 2dp var(--abc-accent);
	padding-left: 8dp;
	padding-top: 3dp;
}

#player-name {
	display: block;
	height: 16dp;
	line-height: 16dp;
	font-size: 10dp;
	font-weight: bold;
	color: var(--abc-text-strong);
	white-space: nowrap;
}

#player-model-row {
	display: block;
	height: 14dp;
	line-height: 14dp;
	font-size: 8dp;
}

#player-model-label {
	display: inline-block;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: var(--abc-text-dim);
	margin-right: 6dp;
}

#player-model-name {
	display: inline-block;
	color: var(--abc-accent);
}

/* ---- footer ------------------------------------------------------------ */

#menu-footer {
	position: absolute;
	left: 26dp;
	right: 26dp;
	top: 452dp;
	width: auto;
	height: 14dp;
}

#menu-hint {
	display: inline-block;
	font-size: 8dp;
	height: 14dp;
	line-height: 14dp;
}

#menu-version {
	display: inline-block;
	float: right;
	font-size: 8dp;
	height: 14dp;
	line-height: 14dp;
}

/* Inputs share one rule; the multiline box adds rows and line breaks. */
#text-field, #password-field, #area-field {
	display: inline-block;
	box-sizing: border-box;
	width: 100%;
	height: 24dp;
	line-height: 22dp;
	background-color: var(--abc-inset);
	color: var(--abc-text);
	font-size: 10dp;
	padding: 0dp 6dp;
	border: 1dp var(--abc-line);
	tab-index: auto;
	white-space: nowrap;
	margin-bottom: 8dp;
}

#area-field {
	height: 56dp;
	line-height: 16dp;
	white-space: normal;
	overflow: hidden;
}

#text-field:focus, #password-field:focus, #area-field:focus {
	border: 1dp var(--abc-accent);
	background-color: #0e1418;
}

#text-field caret, #password-field caret, #area-field caret {
	display: inline-block;
	background-color: #e8e8e8;
}

/* T09 shell: the two home sections of the state machine. Only one section
   is ever visible (the module's sync decides); pause starts hidden so the
   shipped document boots on the no-map home. */
#page-main {
	display: block;
}

#page-pause {
	display: none;
}

/* Shared panel text of the stub/confirm windows (mainmenu.rml keeps its own
   ids; these are the element defaults the two windows rely on). */
p {
	display: block;
	font-size: 10dp;
	color: var(--abc-text);
	margin-bottom: 12dp;
}

#confirm-actions {
	display: block;
}

#confirm-actions button {
	display: inline-block;
	width: auto;
	margin: 0dp 5dp;
}
#confirm-actions button:first-child { margin-left: 0dp; }
#confirm-actions button:last-child { margin-right: 0dp; }

/* Modal confirmation is a centered, shrink-to-fit prompt over a scrim. It
   carries the shared .settings-layer frame (the same prompt component the
   settings page links) so every confirmation reads identically; this block
   only supplies this window's own strings and placement, while its body
   text, padding, border and centered action row come from settings.rcss.
   The safe cancel button keeps the keyboard focus. */
body#menuconfirm { background-color: #00000088; }
body#menuconfirm #panel {
	display: inline-block;
	left: 50%;
	top: 40dp;
	/* The shared #panel rule pins a 372dp width; the prompt fits its own
	   text, so release it here. */
	width: auto;
	min-height: 128dp;
	transform: translate(-50%, 0dp);
	text-align: center;
}
#confirm-actions { text-align: center; }
#confirm-title {
	font-size: 16dp;
	color: var(--abc-accent);
	margin: 8dp 4dp 12dp 4dp;
}
#confirm-body {
	line-height: 16dp;
	margin: 0dp 4dp 16dp 4dp;
}
