/* demo.rcss - Phase 3 demo document styling. */

body.demo {
	width: 100%;
	height: 100%;
}

#window {
	position: absolute;
	left: 60px;
	top: 60px;
	width: 460px;
	height: auto;
	padding: 18px;
	background-color: #101418e0;
	border: 2px #3f6f4f;
}

h1 {
	font-size: 22px;
	color: #7fd28f;
	margin-bottom: 8px;
}

p {
	margin-bottom: 6px;
}

img {
	margin: 8px 0;
}

/* Scissor proof: fixed box, overflowing inner content must be cut off. */
#clipbox {
	width: 300px;
	height: 48px;
	overflow: hidden;
	border: 1px #c0c0c0;
	background-color: #283040ff;
}

p.overflow {
	white-space: nowrap;
	color: #ffd070;
}

#hint {
	margin-top: 10px;
	font-size: 13px;
	color: #909890;
}
