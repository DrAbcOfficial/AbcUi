/* console.rcss - T16 replacement console overlay. Layout in dp only (the
   context density ratio scales; the logical screen is 640x480dp at every
   resolution - Theme::applyScale), matching the other pages' convention.
   Fixed-size top band (the classic console look): header, scrolling
   history, overlay suggestion list / confirm pane, command row. Only the
   history scrolls. */

#console-box {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 320dp;
	background-color: var(--abc-surface);
	border-bottom: 2dp var(--abc-accent);
}

#console-header {
	position: relative;
	display: block;
	height: 18dp;
	padding-left: 6dp;
	padding-right: 6dp;
	border-bottom: 1dp #2a3036;
}

#console-title {
	display: inline-block;
	height: 18dp;
	line-height: 18dp;
	font-size: 9dp;
	color: var(--abc-accent);
}

#console-count {
	display: inline-block;
	height: 18dp;
	line-height: 18dp;
	margin-left: 12dp;
	font-size: 9dp;
	color: #8a9199;
}

#console-close {
	position: absolute;
	right: 0dp;
	top: 1dp;
	height: 16dp;
	min-width: 0dp;
	font-size: 8dp;
	padding-left: 6dp;
	padding-right: 6dp;
}

/* The output history: the only scrolling region; monospaced so columns in
   engine output survive. */
#console-history {
	position: absolute;
	left: 0dp;
	top: 21dp;
	right: 12dp;
	width: auto;
	height: 276dp;
	overflow: auto;
	padding-left: 6dp;
	padding-right: 6dp;
}

/* No wrapping: engine lines are fixed-height rows (a wrapped long line
   would overlap the fixed 12dp row height - live-caught). Long lines are
   clipped by the container's horizontal scroll; the container scrolls on
   both axes (explicit dp width, so the percentage-collapse trap does not
   apply). */
.console-line {
	display: block;
	height: 12dp;
	white-space: nowrap;
	font-family: Consolas;
	font-size: 9dp;
	line-height: 12dp;
	color: var(--abc-text);
}

.console-line.console-dev {
	color: #9aa2ab;
}

/* Completion dropdown: sits directly above the command row (the modern
   console shape), grows upward from the editor and never exceeds the row cap
   the page enforces (kMaxSuggestions + the "more" hint row). */
#console-suggestions {
	position: absolute;
	left: 6dp;
	bottom: 22dp;
	width: 260dp;
	max-height: 132dp;
	overflow-y: auto;
	background-color: #0b1115f7;
	border: 1dp var(--abc-line);
	border-left: 2dp var(--abc-accent);
	padding-top: 2dp;
	padding-bottom: 2dp;
}

.console-suggestion {
	display: block;
	height: 13dp;
	font-family: Consolas;
	font-size: 9dp;
	line-height: 13dp;
	padding-left: 6dp;
	padding-right: 4dp;
	color: var(--abc-text);
}

.console-suggestion.selected {
	background-color: var(--abc-accent);
	color: var(--abc-accent-ink);
}

/* The "more matches than shown" hint: never selectable, dimmer. */
.console-suggestion-more {
	color: var(--abc-text-dim);
	text-align: right;
	padding-right: 6dp;
}

/* The multi-line paste confirmation pane (modal over the box). */
#console-confirm {
	position: absolute;
	left: 40dp;
	top: 24dp;
	width: 560dp;
	height: 260dp;
	background-color: #181d22f8;
	border: 1dp var(--abc-line);
	padding: 10dp;
}

#console-confirm-lead {
	display: block;
	font-size: 10dp;
	color: #ffd700;
	margin-bottom: 6dp;
}

#console-confirm-text {
	display: block;
	width: 540dp;
	height: 180dp;
	overflow-y: auto;
	font-family: Consolas;
	font-size: 9dp;
	line-height: 12dp;
	color: var(--abc-text);
	white-space: pre-wrap;
	margin-bottom: 6dp;
}

#console-confirm-actions button {
	display: inline-block;
	margin-right: 8dp;
}

#console-input-row {
	position: absolute;
	left: 0dp;
	top: 297dp;
	width: 100%;
	height: 21dp;
	border-top: 1dp #2a3036;
}

#console-prompt {
	display: inline-block;
	width: 10dp;
	height: 20dp;
	line-height: 20dp;
	font-family: Consolas;
	font-size: 9dp;
	color: var(--abc-accent);
	padding-left: 6dp;
}

#console-input {
	position: absolute;
	left: 20dp;
	right: 12dp;
	display: inline-block;
	width: auto;
	height: 18dp;
	line-height: 18dp;
	font-family: Consolas;
	font-size: 9dp;
	background-color: var(--abc-inset);
	border: 1dp var(--abc-line);
	color: var(--abc-text);
	padding-left: 4dp;
}
