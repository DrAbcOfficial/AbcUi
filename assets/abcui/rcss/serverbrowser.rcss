/* serverbrowser.rcss - T18 server browser page. All units dp (the context
   density ratio scales; the logical screen is 640x480dp, Theme::applyScale).
   Every region is ABSOLUTELY positioned with explicit dp width/height - the
   same recipe the T16 console history uses: an in-flow auto-width block
   collapsed to a zero-width client box on the live context (rows painted,
   hits landed on a stray scrollbar track; recorded in execution/T18.md).
   The panel is 560dp wide so it fits the logical screen with its margins.
   The list is a bounded scrolling window (64 rows in the DOM max - the T18a
   render cap; paging reaches the rest). */

#sb-panel {
	position: absolute;
	left: 50%;
	margin-left: -280dp;
	top: 24dp;
	width: 560dp;
	height: 418dp;
	background-color: var(--abc-surface);
	border: 1dp var(--abc-line);
	border-top: 2dp var(--abc-accent);
}

#sb-title {
	position: absolute;
	left: 16dp;
	top: 8dp;
	width: 300dp;
	height: 22dp;
	line-height: 22dp;
	font-size: 16dp;
	font-weight: bold;
	color: var(--abc-accent);
}

#sb-tabs {
	position: absolute;
	left: 16dp;
	top: 34dp;
	width: 520dp;
	height: 24dp;
}

#sb-tabs button {
	display: inline-block;
	width: auto;
	height: 24dp;
	line-height: 24dp;
	margin-right: 6dp;
	margin-bottom: 0dp;
	padding-left: 10dp;
	padding-right: 10dp;
}

#sb-tabs button.sb-active {
	background-color: var(--abc-accent-soft);
	border: 1dp var(--abc-accent);
	color: #ffffff;
}

#sb-toolbar {
	position: absolute;
	left: 16dp;
	top: 62dp;
	width: 520dp;
	height: 24dp;
}

#sb-toolbar button {
	display: inline-block;
	width: auto;
	height: 24dp;
	line-height: 24dp;
	margin-right: 6dp;
	margin-bottom: 0dp;
	padding-left: 10dp;
	padding-right: 10dp;
}

#sb-spacer {
	display: inline-block;
	width: 16dp;
}

/* Filter toggles show their state; disabled entries are dimmed. */
#sb-toolbar button.sb-on {
	background-color: var(--abc-accent-soft);
	border: 1dp var(--abc-accent);
	color: #ffffff;
}

#sb-toolbar button.sb-disabled, #sb-paging button.sb-disabled {
	color: #6f757c;
	border-color: #3a4047;
}

/* Column header row: sortable buttons above the list, grid-aligned with the
   row cells (both use the same column widths, sum 506dp <= 526dp content). */
#sb-header {
	position: absolute;
	left: 16dp;
	top: 92dp;
	width: 526dp;
	height: 20dp;
	background-color: #161c22;
	border: 1dp var(--abc-line);
}

.sb-col {
	min-width: 0dp;
	margin-right: 0dp;
	display: inline-block;
	height: 18dp;
	line-height: 18dp;
	background-color: transparent;
	border: 0dp var(--abc-line);
	text-align: left;
	margin-bottom: 0dp;
	padding: 0dp;
	vertical-align: top;
}

.sb-col:hover {
	background-color: #232b32;
}

.sb-col:focus {
	background-color: #232b32;
}

.c-name {
	width: 226dp;
}

.c-map {
	width: 130dp;
}

.c-players {
	width: 90dp;
}

.c-ping {
	width: 60dp;
}

/* Sort direction: the active column lights up (an arrow glyph would need a
   font feature the shipped faces do not carry). */
.sb-sort-asc {
	color: var(--abc-accent);
	font-weight: bold;
}

.sb-sort-desc {
	color: #e8c020;
	font-weight: bold;
}

/* The row window: the only scrolling region (absolute; explicit box). */
#sb-list {
	position: absolute;
	left: 16dp;
	top: 112dp;
	width: 526dp;
	height: 190dp;
	overflow: auto;
	background-color: #0d1114;
	border: 1dp var(--abc-line);
}

.sb-row {
	display: block;
	width: 508dp;
	height: 26dp;
	line-height: 26dp;
	border-bottom: 1dp var(--abc-line-soft);
	tab-index: auto;
	font-size: 9dp;
	overflow: hidden;
}

.sb-row:nth-child(even) {
	background-color: #11161b;
}

.sb-row.sb-selected {
	background-color: var(--abc-accent-soft);
}

.sb-row span {
	box-sizing: border-box;
	display: inline-block;
	height: 26dp;
	vertical-align: top;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	padding-right: 6dp;
}

/* The password marker rides the name cell (detail panel spells it out). */
.m-flag {
	color: #e8c020;
}

.sb-empty, .sb-hint {
	display: block;
	font-size: 9dp;
	color: #8a9199;
	padding: 6dp;
}

#sb-paging {
	position: absolute;
	left: 16dp;
	top: 306dp;
	width: 526dp;
	height: 22dp;
}

#sb-paging button {
	min-width: 0dp;
	display: inline-block;
	width: 24dp;
	height: 22dp;
	line-height: 22dp;
	margin-right: 6dp;
	margin-bottom: 0dp;
}

#sb-page-label {
	display: inline-block;
	height: 22dp;
	line-height: 22dp;
	font-size: 9dp;
	color: #8a9199;
	vertical-align: top;
}

/* Detail panel: the selected server + its player list (single slot). */
#sb-detail-box {
	position: absolute;
	left: 16dp;
	top: 332dp;
	width: 526dp;
	height: 52dp;
	box-sizing: border-box;
	background-color: #161c22;
	border: 1dp var(--abc-line);
	padding: 6dp;
	overflow: hidden;
}

#sb-detail-info h2, #sb-detail-name {
	display: block;
	font-size: 11dp;
	font-weight: bold;
	color: var(--abc-text);
	margin-bottom: 2dp;
}

.sb-detail-line {
	display: block;
	font-size: 9dp;
	color: #8a9199;
	margin-bottom: 2dp;
}

.sb-player {
	display: block;
	height: 12dp;
	line-height: 12dp;
	font-size: 8.5dp;
}

.sb-player span {
	display: inline-block;
	height: 12dp;
	vertical-align: top;
	overflow: hidden;
	white-space: nowrap;
}

.dp-name {
	width: 260dp;
}

.dp-score {
	width: 90dp;
}

.dp-time {
	width: 60dp;
}

#sb-status {
	position: absolute;
	left: 16dp;
	top: 402dp;
	width: 526dp;
	height: 12dp;
	font-size: 9dp;
	color: var(--abc-text);
}

#sb-actions {
	position: absolute;
	left: 50%;
	margin-left: -280dp;
	top: 448dp;
	width: 560dp;
	height: 22dp;
}

.sb-row:hover { background-color: var(--abc-surface-3); }
#sb-connect { border-color: var(--abc-accent-soft); color: var(--abc-accent); }

#sb-actions button {
	display: inline-block;
	width: auto;
	height: 22dp;
	line-height: 22dp;
	padding-left: 12dp;
	padding-right: 12dp;
	margin-bottom: 0dp;
}

/* Original icon columns: password, VAC status, bot count. */
.c-flags { display: inline-block; width: 42dp; height: 18dp; vertical-align: top; }
.c-bots { display: inline-block; width: 30dp; height: 18dp; font-size: 9dp; vertical-align: top; }
.c-name { width: 154dp; }
.server-icon { display: inline-block; width: 16dp; height: 16dp; margin-right: 3dp; }
#sb-header .c-flags { font-size: 8dp; }
#sb-tabs button { padding: 0dp 6dp; margin-right: 3dp; }
#sb-filter-panel { display: none; position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; z-index: 200; background-color: #000000bb; }
#sb-filter-content { position: absolute; left: 50%; margin-left: -186dp; top: 50dp; width: 340dp; padding: 16dp; background-color: var(--abc-surface); border: 1dp var(--abc-line); }
#sb-filter-content h1 { display: block; font-size: 16dp; color: var(--abc-accent); }
#sb-filter-content input, #sb-filter-content select { display: block; width: 324dp; height: 24dp; margin-bottom: 8dp; font-size: 10dp; }
#sb-filter-content input, #sb-blacklist-address { background-color: #0a0e12; color: #e8e8e8; border: 1dp #536071; tab-index: auto; }
#sb-filter-content button { display: inline-block; box-sizing: border-box; width: 150dp; font-size: 9dp; margin: 3dp; }
#sb-filter-content button.sb-on { background-color: var(--abc-accent-soft); border: 1dp var(--abc-accent); }
#sb-blacklist-panel { display: none; position: absolute; top: 236dp; left: 16dp; width: 526dp; height: 160dp; }
#sb-blacklist-address { width: 240dp; height: 22dp; font-size: 10dp; }
#sb-blacklist-panel button { display: inline-block; height: 22dp; font-size: 9dp; }
#sb-blacklist-rules { display: block; height: 95dp; overflow: auto; }
.sb-blacklist-rule { display: block; height: 26dp; }
.sb-blacklist-rule span { display: inline-block; width: 410dp; height: 24dp; font-size: 9dp; color: #dce1e7; overflow: hidden; }
.sb-blacklist-rule button { width: 70dp; }
#sb-panel.sb-blacklist-mode #sb-list { height: 90dp; }
#sb-panel.sb-blacklist-mode #sb-paging { top: 206dp; }
#sb-panel.sb-blacklist-mode #sb-detail-box { display: none; }
#sb-blacklist-rules scrollbarvertical { width: 0dp; }
#sb-blacklist-rules scrollbarvertical sliderbar { width: 10dp; min-height: 24dp; margin-left: -10dp; background-color: #536071; }
#sb-actions button { padding: 0dp 5dp; font-size: 9dp; }
#sb-connect:focus { color: var(--abc-accent-ink); }
#sb-actions button.sb-disabled, #sb-actions button.sb-disabled:focus {
	background-color: var(--abc-inset);
	color: var(--abc-text-dim);
	border-color: var(--abc-line);
}
