/* creategame.rcss - T19 create-local-game page. All units dp (the context
   density ratio scales; the logical screen is 640x480dp, Theme::applyScale).
   Every region is ABSOLUTELY positioned with explicit dp width/height - the
   T16 console / T18 browser recipe: an in-flow auto-width block collapsed to
   a zero-width client box on the live context. The panel is 400dp wide so it
   fits the logical screen with margins; the map select is a real form control
   (keyboard reachable, T13 pin). */

#cg-panel {
	position: absolute;
	left: 50%;
	margin-left: -210dp;
	top: 40dp;
	width: 420dp;
	height: 396dp;
	background-color: var(--abc-surface);
	border: 1dp var(--abc-line);
	border-top: 2dp var(--abc-accent);
}

#cg-title {
	position: absolute;
	left: 16dp;
	top: 10dp;
	width: 380dp;
	height: 24dp;
	line-height: 24dp;
	font-size: 16dp;
	font-weight: bold;
	color: var(--abc-accent);
}

.cg-label {
	position: absolute;
	left: 16dp;
	width: 90dp;
	height: 20dp;
	line-height: 20dp;
	font-size: 9dp;
	color: #c8c8c8;
}

#cg-map-label { top: 46dp; }
#cg-players-label { top: 82dp; }
#cg-name-label { top: 118dp; }
#cg-password-label { top: 154dp; }

#cg-map {
	position: absolute;
	left: 110dp;
	top: 44dp;
	width: 292dp;
	height: 24dp;
	font-size: 9dp;
}

#cg-players {
	position: absolute;
	left: 110dp;
	top: 80dp;
	width: 80dp;
	height: 24dp;
	font-size: 9dp;
}

#cg-name {
	position: absolute;
	left: 110dp;
	top: 116dp;
	width: 292dp;
	height: 24dp;
	font-size: 9dp;
}

#cg-password {
	position: absolute;
	left: 110dp;
	top: 152dp;
	width: 292dp;
	height: 24dp;
	font-size: 9dp;
}

#cg-hint {
	position: absolute;
	left: 16dp;
	top: 190dp;
	width: 388dp;
	height: 40dp;
	font-size: 9dp;
	color: #ff8866;
}

#cg-actions {
	position: absolute;
	left: 16dp;
	top: 336dp;
	width: 388dp;
	height: 32dp;
}

#cg-actions button {
	display: inline-block;
	width: 150dp;
	height: 28dp;
	line-height: 28dp;
	margin-right: 10dp;
}

#cg-fields .cg-label { color: var(--abc-text-dim); }
#cg-fields select { width: 350dp; }
#cg-fields select selectbox { max-height: 144dp; }
#cg-fields .row-value { display: inline-block; width: 32dp; text-align: right; }
#cg-apply { border-color: var(--abc-accent-soft); color: var(--abc-accent); }

#cg-fields { position: absolute; left: 16dp; top: 44dp; width: 388dp; height: 270dp; overflow: auto; }
#cg-fields .cg-label { position: static; display: block; width: 370dp; height: 16dp; line-height: 16dp; margin: 3dp 0dp; }
#cg-fields input, #cg-fields select, #cg-map, #cg-players, #cg-name, #cg-password { position: static; display: inline-block; box-sizing: border-box; width: 330dp; height: 24dp; font-size: 10dp; margin-bottom: 2dp; }
#cg-fields input { background-color: #101418; color: var(--abc-text); border: 1dp #536071; tab-index: auto; }
#cg-fields input:focus { border: 1dp var(--abc-accent); }
#cg-lan { width: 90dp; }
#cg-hint { top: 316dp; height: 20dp; }
#cg-fields scrollbarvertical { width: 0dp; }
#cg-fields scrollbarvertical sliderbar { width: 10dp; min-height: 24dp; margin-left: -10dp; background-color: #536071; }
#cg-fields input.cg-slider {
	width: 296dp;
	background-color: transparent;
	border-width: 0dp;
}
#cg-apply:focus { color: var(--abc-accent-ink); }
