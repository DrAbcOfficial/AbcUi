/* health.rcss - HealthPanel layout. Coordinates from the old
   abcenchance/res/HealthPanel.res (proportional units -> 1:1 dp). */

#health {
	position: absolute;
	left: 0dp;
	bottom: 0dp;
	width: 300dp;
	height: 30dp;
}

#health .bg {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 300dp;
	height: 30dp;
}

/* Health icon (6, center) 15x15; label (14, center) 48x30; bar (55) 56x11.
   The armor group mirrors it at +120dp/169dp (old res values). The bar
   fill clips through the wrapper: its width animates with the value
   (old AnimationController RunAnimationCommand wide, 0.15s linear). */
#health-icon, #armor-icon {
	position: absolute;
	top: 7.5dp;
	width: 15dp;
	height: 15dp;
}
#health-icon { left: 6dp; }
#armor-icon { left: 120dp; }

#health-label, #armor-label {
	position: absolute;
	top: 0dp;
	width: 48dp;
	height: 30dp;
	text-align: center;
}
#health-label { left: 14dp; }
#armor-label { left: 128dp; }

#health-bar-wrap, #armor-bar-wrap {
	position: absolute;
	top: 9.5dp;
	width: 56dp;
	height: 11dp;
	overflow: hidden;
	transition: width 0.15s linear;
}
#health-bar-wrap { left: 55dp; }
#armor-bar-wrap { left: 169dp; }

/* Old HealthBar/ArmorBar "BarBgColor": white @ 125 alpha. */
#health-bar-bg, #armor-bar-bg {
	position: absolute;
	top: 9.5dp;
	width: 56dp;
	height: 11dp;
	background-color: #ffffff7d;
}
#health-bar-bg { left: 55dp; }
#armor-bar-bg { left: 169dp; }

#health-bar, #armor-bar {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 56dp;
	height: 11dp;
}

#longjump {
	position: absolute;
	left: 248dp;
	top: 5dp;
	width: 20dp;
	height: 20dp;
	visibility: hidden;
}
