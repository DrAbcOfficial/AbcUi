<rml>
<head>
	<link type="text/rcss" href="../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/dmgtiles.rcss"/>
</head>
<body id="dmgtiles">
	<!-- Old CDmgTilesPanel (100x100 bottom-left, rs1.6 anchor = bottom edge
	     60dp up: y = parentH - tall*1.6). Tiles pack bottom-up; the localized
	     labels are filled in by DmgTilesPanel::onDocumentReady. -->
	<div id="tiles">
		<div id="tile-poison" class="tile"><img class="icon" src="../img/icon_poison.tga"/><div id="label-poison" class="label font-default">DMGTiles_Poison</div></div>
		<div id="tile-acid" class="tile"><img class="icon" src="../img/icon_acid.tga"/><div id="label-acid" class="label font-default">DMGTiles_Acid</div></div>
		<div id="tile-freeze" class="tile"><img class="icon" src="../img/icon_freeze.tga"/><div id="label-freeze" class="label font-default">DMGTiles_Freeze</div></div>
		<div id="tile-drown" class="tile"><img class="icon" src="../img/icon_drown.tga"/><div id="label-drown" class="label font-default">DMGTiles_Drown</div></div>
		<div id="tile-burn" class="tile"><img class="icon" src="../img/icon_burn.tga"/><div id="label-burn" class="label font-default">DMGTiles_Burn</div></div>
		<div id="tile-gas" class="tile"><img class="icon" src="../img/icon_gas.tga"/><div id="label-gas" class="label font-default">DMGTiles_Gas</div></div>
		<div id="tile-radiation" class="tile"><img class="icon" src="../img/icon_radiation.tga"/><div id="label-radiation" class="label font-default">DMGTiles_Radiation</div></div>
		<div id="tile-shock" class="tile"><img class="icon" src="../img/icon_shock.tga"/><div id="label-shock" class="label font-default">DMGTiles_Shock</div></div>
		<div id="tile-beam" class="tile"><img class="icon" src="../img/icon_beam.tga"/><div id="label-beam" class="label font-default">DMGTiles_Energybeam</div></div>
		<div id="tile-sonic" class="tile"><img class="icon" src="../img/icon_sonic.tga"/><div id="label-sonic" class="label font-default">DMGTiles_Sonic</div></div>
	</div>
</body>
</rml>
