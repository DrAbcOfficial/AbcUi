<rml>
<head>
	<link type="text/rcss" href="../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
</head>
<!-- The console placeholder overlay (menuconsole instance): the legacy
     console is fully suppressed by the takeover, and until the replacement
     console (T16) this placeholder proves the overlay stack instead. The
     real console document will take over this instance's slot. -->
<body id="menuconsole">
	<div id="panel">
		<h1 id="stub-title"></h1>
		<p id="stub-body"></p>
		<button id="stub-return" data-action="return" data-label="#MainMenu_Close" autofocus="autofocus">#MainMenu_Close</button>
	</div>
</body>
</rml>
