<rml>
<head>
	<link type="text/rcss" href="../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/health.rcss"/>
</head>
<body id="health">
	<img class="bg" src="../img/healthpanel_background.tga"/>

	<img id="health-icon" class="icon" src="../img/healthbar_icon.tga"/>
	<div id="health-label" class="font-hudnum">0</div>
	<div id="health-bar-bg"></div>
	<div id="health-bar-wrap"><img id="health-bar" src="../img/healthbar.tga"/></div>

	<img id="armor-icon" class="icon" src="../img/armorbar_icon.tga"/>
	<div id="armor-label" class="font-hudnum">0</div>
	<div id="armor-bar-bg"></div>
	<div id="armor-bar-wrap"><img id="armor-bar" src="../img/armorbar.tga"/></div>

	<img id="longjump" src="../img/longjump.tga"/>
</body>
</rml>
