<rml>
<head>
	<link type="text/rcss" href="../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
</head>
<!-- The "not yet implemented" sub-page stub (menusub instance): every menu
     surface without a replacement routes here instead of any original
     window; title/body are set at show time by the module. -->
<body id="menusub">
	<div id="panel">
		<h1 id="stub-title"></h1>
		<p id="stub-body"></p>
		<button id="stub-return" data-action="return" data-label="#MainMenu_Return" autofocus="autofocus">#MainMenu_Return</button>
	</div>
</body>
</rml>
