<rml>
<head>
	<link type="text/rcss" href="../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
	<link type="text/rcss" href="../rcss/settings.rcss"/>
</head>
<!-- T10 basic settings page, T11 key-binding section. The cvar row list is
     built at load time from the production description table
     (services::settings::FirstBatchRows); the bind row list from the
     kb_act.lst action table (services::settings::KeyBindModel). These
     skeletons only carry the fixed frames, the action bars and the
     page-internal layers. Every dynamic string is injected escaped by
     panels::settings::SettingsPage. -->
<body id="menusettings">
	<div id="panel">
		<h1 id="title">#Settings_Title</h1>
		<div id="settings-status"></div>
		<div id="rows"></div>
		<h2 id="bind-title">#Settings_KeysTitle</h2>
		<div id="bind-status"></div>
		<div id="bindrows"></div>
		<h2 id="video-title">#Settings_VideoTitle</h2>
		<div id="video-section">
			<div class="row" id="video-row-resolution">
				<div class="row-label">#Settings_VideoResolution</div>
				<select class="video-select" id="video-resolution"></select>
			</div>
			<div class="row" id="video-row-windowed">
				<div class="row-label">#Settings_VideoWindowed</div>
				<button class="row-toggle" id="video-windowed" data-action="video-toggle-windowed"></button>
			</div>
			<div id="video-status"></div>
			<div id="video-actions">
				<button id="video-apply" data-action="video-apply" data-label="#Settings_VideoApply">#Settings_VideoApply</button>
			</div>
		</div>
		<!-- T13 voice section: the voice cvar rows (voice_scale /
		     voice_modenable) ride the #rows table above; these are the
		     IVoiceTweak hardware rows. The ids are page contracts; the
		     whole section fail-closes when the engine interface is
		     missing. -->
		<h2 id="voice-title">#Settings_VoiceTitle</h2>
		<div id="voice-section">
			<div class="row" id="voice-row-volume">
				<div class="row-label">#Settings_MicVolume</div>
				<input class="row-input" type="text" id="voice-mic-volume"/>
			</div>
			<div class="row" id="voice-row-boost">
				<div class="row-label">#Settings_MicBoost</div>
				<button class="row-toggle" id="voice-mic-boost" data-action="voice-mic-boost"></button>
			</div>
			<div class="row" id="voice-row-test">
				<div class="row-label">#Settings_MicTest</div>
				<button class="row-toggle" id="voice-mic-test" data-action="voice-test"></button>
			</div>
			<div id="voice-status"></div>
		</div>
	</div>
	<div id="settings-actions">
		<button id="settings-apply" data-action="apply" data-label="#Settings_Apply" autofocus="autofocus">#Settings_Apply</button>
		<button id="settings-return" data-action="return" data-label="#MainMenu_Return">#MainMenu_Return</button>
		<button id="settings-reset" data-action="reset-defaults" data-label="#Settings_ResetDefaults">#Settings_ResetDefaults</button>
		<button id="bind-reset" data-action="bind-reset-defaults" data-label="#Settings_BindResetDefaults">#Settings_BindResetDefaults</button>
	</div>
	<!-- Page-internal layers live OUTSIDE the scrollable panel: they
	     anchor to the document and stay viewport-covering no matter how
	     far the bind list is scrolled (absolute layers inside the scroll
	     container scroll out of the visible area - live-caught). -->
		<!-- Page-internal layers (not controller overlays): restore defaults
		     always confirms (cvars and key bindings separately); leaving with
		     unsaved drafts prompts; a capture landing on a bound key asks
		     before replacing. Safe default focus sits on the non-destructive
		     entry. -->
		<div id="reset-confirm" class="settings-layer">
			<p id="reset-confirm-text">#Settings_ResetConfirm</p>
			<button id="reset-yes" data-action="reset-yes" data-label="#Settings_ResetYes">#Settings_ResetYes</button>
			<button id="reset-no" data-action="reset-no" data-label="#Settings_Cancel" autofocus="autofocus">#Settings_Cancel</button>
		</div>
		<div id="leave-confirm" class="settings-layer">
			<p id="leave-confirm-text">#Settings_UnsavedConfirm</p>
			<button id="leave-discard" data-action="leave-discard" data-label="#Settings_DiscardReturn">#Settings_DiscardReturn</button>
			<button id="leave-stay" data-action="leave-stay" data-label="#Settings_Stay" autofocus="autofocus">#Settings_Stay</button>
		</div>
		<div id="bind-conflict" class="settings-layer">
			<p id="bind-conflict-text"></p>
			<button id="bind-conflict-yes" data-action="bind-conflict-yes" data-label="#Settings_BindConflictYes">#Settings_BindConflictYes</button>
			<button id="bind-conflict-no" data-action="bind-conflict-no" data-label="#Settings_Cancel" autofocus="autofocus">#Settings_Cancel</button>
		</div>
		<div id="bind-reset-confirm" class="settings-layer">
			<p id="bind-reset-confirm-text">#Settings_BindResetConfirm</p>
			<button id="bind-reset-yes" data-action="bind-reset-yes" data-label="#Settings_ResetYes">#Settings_ResetYes</button>
			<button id="bind-reset-no" data-action="bind-reset-no" data-label="#Settings_Cancel" autofocus="autofocus">#Settings_Cancel</button>
		</div>
</body>
</rml>
