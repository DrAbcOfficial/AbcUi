<body id="playerboard">
	<!-- Old CPlayerInfoPanel fleet (PlayerBoardPanel.res per-index SetId):
	     one 80x16 world-anchored tile per player slot, positioned by the
	     onRedraw projection. Empty slots stay display:none (near-zero cost). -->
	<div class="tile" id="tile-1">
		<img class="background" src="../img/playertitle/playertitle_background.tga"/>
		<div class="bar bar-health"><img src="../img/playertitle/playertitle_healthbar.tga"/></div>
		<div class="bar bar-armor"><img src="../img/playertitle/playertitle_armorbar.tga"/></div>
		<div class="name"></div>
		<img class="icon icon-crouch" src="../img/playertitle/playertitle_crouchicon.tga"/>
