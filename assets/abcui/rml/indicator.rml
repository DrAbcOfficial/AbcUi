<rml>
<head>
	<link type="text/rcss" href="../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/indicator.rcss"/>
</head>
<body id="indicator">
	<!-- Old CIndicatorPanel (400x400 centered): 4 cycling image slots; each
	     rotor is a full-viewport div rotated around the screen center, the
	     img inside carries the old res offsets (30/40/50/50). -->
	<div id="rotor-1" class="rotor"><img class="pain" src="texadd://abcui/img/pain_indicator.tga"/></div>
	<div id="rotor-2" class="rotor"><img class="pain" src="texadd://abcui/img/pain_indicator.tga"/></div>
	<div id="rotor-3" class="rotor"><img class="pain" src="texadd://abcui/img/pain_indicator.tga"/></div>
	<div id="rotor-4" class="rotor"><img class="pain" src="texadd://abcui/img/pain_indicator.tga"/></div>
</body>
</rml>
