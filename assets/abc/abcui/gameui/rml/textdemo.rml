<rml>
<head>
	<link type="text/rcss" href="../../rcss/base.rcss"/>
	<link type="text/rcss" href="../../rcss/theme.rcss"/>
	<link type="text/rcss" href="../rcss/mainmenu.rcss"/>
</head>
<!-- T05/T07 offline-test fixture (the original T05 demo page)
     the menu shell can load it through MainMenuPage's document-path parameter.
     Not loaded by any production code path - the shipped menu shell is
     mainmenu.rml. -->
<body id="mainmenu">
	<div id="panel">
		<h1 id="title">#MainMenu_Title</h1>
		<div id="focus-status">#MainMenu_FocusNone</div>
		<button id="action-button" data-action="action" data-label="#MainMenu_Action" autofocus="autofocus">#MainMenu_Action</button>
		<input id="text-field" type="text" data-label="#MainMenu_Text"/>
		<input id="password-field" type="password" data-label="#MainMenu_Password"/>
		<textarea id="area-field" rows="3" maxlength="100" data-label="#MainMenu_Area"/>
		<button id="close-button" data-action="close" data-label="#MainMenu_Close">#MainMenu_Close</button>
		<button id="return-button" data-action="return" data-label="#MainMenu_Return">#MainMenu_Return</button>
	</div>
</body>
</rml>
