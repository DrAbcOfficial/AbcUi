/* ammobar.rcss - AmmoPanel layout, from the old
   abcenchance/res/AmmoPanel.res (bottom-right anchor, 170x30). */

#ammobar {
	position: absolute;
	right: 0dp;
	bottom: 0dp;
	width: 170dp;
	height: 30dp;
}

#ammobar .bg {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 170dp;
	height: 30dp;
}

#ammo1-icon, #ammo2-icon {
	position: absolute;
	top: 7.5dp;
	width: 15dp;
	height: 15dp;
	/* Old AmmoBar.Ammo1/2IconColor = scheme Default. */
	image-color: var(--abc-hud-accent);
	visibility: hidden;
}
#ammo1-icon { left: 0dp; }
#ammo2-icon { left: 145dp; }

/* Old AmmoBar.Ammo1/2FgColor = scheme Default. */
#ammo1, #ammo2 {
	color: var(--abc-hud-accent);
}
#ammo1, #ammo2, #slash {
	position: absolute;
	top: 0dp;
	height: 30dp;
	/* vgui Labels centre their text vertically; Rml needs the explicit
	   line box (box height = one line). */
	line-height: 30dp;
}
#ammo1 {
	left: 20dp;
	width: 44dp;
	/* Old res autowidetocontents anchors the text at xpos (grows right). */
	text-align: left;
}
/* Old res: ypos cs-0.54 on a 30dp tall box (top = 15 - 0.54*30 = -1.2). */
#slash {
	left: 80dp;
	width: 12dp;
	top: -1.2dp;
	text-align: center;
	/* Old scheme AmmoBar.SlashFgColor. */
	color: #ff0000;
}
#ammo2 {
	left: 100dp;
	width: 44dp;
	text-align: left;
}
