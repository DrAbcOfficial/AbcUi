/* health.rcss - HealthPanel layout, HL2-inspired but not a copy: the vital
   readout is an amber icon plus one large amber number drawn straight on the
   scene (HL2 has no plate behind the vitals), while the vgui-era meter stays
   as the bar indicator under each value - the bar fill still animates by
   value/100 with the old 0.15s linear ramp.

   Geometry (design units, 1dp = one old proportional unit):
     health group  icon 0,4 20x20   number 26,0 78x28   meter 26,32 92x5
     armor group   icon 150,4 20x20 number 176,0 78x28  meter 176,32 92x5
     longjump icon 272,4 (visibility from the suit bit)
   The number box is 28 tall with a 28 line box, so the glyph band centres on
   the icon centre (4 + 10 = 14 = box centre). */

#health {
	position: absolute;
	left: 18dp;
	bottom: 12dp;
	width: 300dp;
	height: 46dp;
}

/* HL2-style vitals type: one big amber value per group. Verdana Bold stands
   in for the old CompactaBold. The value ink is additive glyphs
   (framework::glyphs), so there is no outline: black would add nothing
   anyway, and the additive blend keeps the readout glowing over the scene. */
#health .font-vital {
	font-family: Verdana;
	font-weight: bold;
	font-size: 20dp;
	letter-spacing: 0.4dp;
	white-space: nowrap;
}

/* Additive glyph run: .hud-glyph (base.rcss) carries the cell sizing, the
   black outline layer, the accent tint and the value opacity; the run
   inherits the 20dp type above so the ink follows the value size. */

#health-icon, #armor-icon {
	position: absolute;
	top: 4dp;
	width: 20dp;
	height: 20dp;
	/* HUD accent (was scheme Default); applyDanger shifts the hue toward red
	   below hud_danger_health / hud_danger_armor. */
	image-color: var(--abc-hud-accent);
	/* Translucent readout: the sprite is a step softer than the value. */
	opacity: var(--abc-hud-icon-opacity);
}
#health-icon { left: 0dp; }
#armor-icon { left: 150dp; }

#health-label, #armor-label {
	position: absolute;
	top: 0dp;
	width: 78dp;
	height: 28dp;
	text-align: left;
	/* vgui Labels centre their text vertically; Rml needs the explicit
	   line box (box height = one line). */
	line-height: 28dp;
	/* HUD accent; the danger rule overrides per value at runtime. */
	color: var(--abc-hud-accent);
	opacity: var(--abc-hud-value-opacity);
}
#health-label { left: 26dp; }
#armor-label { left: 176dp; }

#health-bar-wrap, #armor-bar-wrap {
	position: absolute;
	top: 32dp;
	width: 92dp;
	height: 5dp;
	overflow: hidden;
	border-radius: 2dp;
	transition: width 0.15s linear-in;
}
#health-bar-wrap { left: 26dp; }
#armor-bar-wrap { left: 176dp; }

/* Meter well: the black track behind the additive fill (restored - the fill
   is light on its own, the well gives it an edge on bright floors). The
   elements stay in the tree because HealthPanel toggles them with the group
   visibility. */
#health-bar-bg, #armor-bar-bg {
	position: absolute;
	top: 32dp;
	width: 92dp;
	height: 5dp;
	background-color: var(--abc-hud-track);
	border-radius: 2dp;
}
#health-bar-bg { left: 26dp; }
#armor-bar-bg { left: 176dp; }

/* In-flow (display:block) so overflow:hidden on the wrap clips the fill
   reliably (RmlUi clipping of abs-positioned children is not guaranteed). */
/* Additive meter strip (texadd:// in the document): .hud-meter carries the
   tint and the meter opacity, the wrap clips it to the value. */
#health-bar, #armor-bar {
	display: block;
	width: 92dp;
	height: 5dp;
}

#longjump {
	position: absolute;
	left: 272dp;
	top: 4dp;
	width: 20dp;
	height: 20dp;
	visibility: hidden;
	image-color: var(--abc-hud-accent);
	opacity: var(--abc-hud-icon-opacity);
}
