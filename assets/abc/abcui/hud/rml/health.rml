<rml>
<head>
	<link type="text/rcss" href="../../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/health.rcss"/>
</head>
<body id="health">
	<!-- HL2-inspired vitals: amber icon + large amber number straight on the
	     scene, with the vgui-era meter kept underneath each value. The old
	     vgui plate is gone; the numbers carry a one-pixel outline instead
	     (rcss font-effect) so they stay readable on bright maps. -->
	<img id="health-icon" class="icon" src="../img/healthbar_icon.png"/>
	<div id="health-label" class="font-vital">0</div>
	<div id="health-bar-bg"></div>
	<div id="health-bar-wrap"><div id="health-bar"></div></div>

	<img id="armor-icon" class="icon" src="../img/armorbar_icon.png"/>
	<div id="armor-label" class="font-vital">0</div>
	<div id="armor-bar-bg"></div>
	<div id="armor-bar-wrap"><div id="armor-bar"></div></div>

	<img id="longjump" src="../img/longjump.png"/>
</body>
</rml>
