<rml>
<head>
	<link type="text/rcss" href="../../rcss/base.rcss"/>
	<link type="text/rcss" href="../rcss/sidetext.rcss"/>
</head>
<body id="sidetext">
	<!-- Side readout (old SidePanel): a small amber score glyph plus the value
	     template. HL2-style - no plate behind it, no money prefix; the panel
	     rewrites #message from the {SCORE}/{SPEED}/{MAXSPEED} template. -->
	<div id="readout">
		<img id="score-icon" src="../img/score_icon.png"/>
		<div id="message">{SCORE}</div>
	</div>
</body>
</rml>
