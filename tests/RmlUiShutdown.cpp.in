// Production shutdown-body regression: CMake extracts the actual spine bodies.
// Only external services are faked; no copy of the shutdown decision logic.
#include "modules/Module.h"

#include <cstdlib>
#include <iostream>
#include <memory>
#include <string>
#include <vector>

namespace {
std::vector<std::string> Log;
bool ContextAlive = false;
void record(const char* event) { Log.emplace_back(event); }
}

namespace abc {
void ConsoleWarn(const char*, ...) {}
struct Renderer {
	void UnregisterRenderCallbacks(void*) { record("unregister"); }
};
Renderer* MetaRenderer() { static Renderer renderer; return &renderer; }
}
namespace Rml {
void Shutdown() { record("context"); ContextAlive = false; }
}
namespace framework::PanelManager { void shutdown() { record("panels"); } }
namespace sprites { void shutdown() { record("sprites"); } }
namespace avatars { void shutdown() { record("avatars"); } }
namespace steamapi { void shutdown() { record("steam"); } }
namespace vgui2ext { void shutdown() { record("vgui"); } }
namespace rmlui {
bool Initialised = false;
Rml::Context* Context = nullptr;
struct RendererInterface { void clearAdditiveTextures() { record("textures"); } };
struct RendererCallbacks { std::unique_ptr<RendererInterface> RenderInterface; } Callbacks;
std::unique_ptr<int> FileInterface, SystemInterface;
void closeProbeDocument() { record("probe"); }
// T06 ownership seam: the production shutdown body resets the input router
// FIRST (tokens release while every owner can still clean up), then drops
// the T07 text/IME state (cached TextInputContext pointers) while the DOM
// still exists.
struct RouterResetStub { void reset() { record("router"); } };
RouterResetStub& uiRouter() { static RouterResetStub router; return router; }
void textInputShutdown() { record("textinput"); }
@ABC_UI_SHUTDOWN@
@ABC_UI_HUD_SHUTDOWN@
}

#define CHECK(x) do { if (!(x)) { std::cerr << __LINE__ << ": " << #x << '\n'; std::exit(1); } } while (0)

namespace {
class FakeModule final : public modules::IUiModule {
public:
	const char* name() const override { return "shutdown-test"; }
	void onInit() override { record("init"); }
	void onContextReady(Rml::Context*) override { record("ready"); }
	void onShutdown() override {
		CHECK(!ExpectContext || (ContextAlive && rmlui::Context));
		record("module");
	}
	bool ExpectContext = false;
};
void expect(std::initializer_list<const char*> wanted) {
	std::vector<std::string> expected(wanted.begin(), wanted.end());
	CHECK(Log == expected);
	Log.clear();
}
}

int main() {
	static FakeModule module;
	auto& reg = modules::registry();
	reg.add(&module);
	// Exit before HUD_Init must not dispatch shutdown to an uninitialised
	// module; the router reset still runs first on every teardown entry.
	rmlui::shutdown();
	expect({"router", "textinput"});
	// HUD_Init -> HUD_Shutdown before the first HUD_Frame/context.
	reg.initAll();
	rmlui::onHudShutdown();
	expect({"init", "router", "textinput", "module"});
	// ExitGame enters the same production shutdown; it must be a no-op now.
	rmlui::shutdown();
	rmlui::onHudShutdown();
	expect({"router", "textinput", "router", "textinput"});
	// Another init-only cycle must re-arm teardown without contextReady.
	reg.initAll();
	rmlui::shutdown();
	expect({"init", "router", "textinput", "module"});
	// Context creation re-arms teardown even without another HUD_Init.
	for (int cycle = 0; cycle < 2; ++cycle) {
		ContextAlive = true;
		module.ExpectContext = true;
		rmlui::Initialised = true;
		rmlui::Context = reinterpret_cast<Rml::Context*>(&module);
		rmlui::Callbacks.RenderInterface = std::make_unique<rmlui::RendererInterface>();
		reg.contextReadyAll(rmlui::Context);
		rmlui::onHudShutdown();
		expect({"ready", "router", "textinput", "unregister", "module", "probe", "panels", "textures", "context", "sprites", "avatars", "steam", "vgui"});
		CHECK(!ContextAlive && !rmlui::Initialised && !rmlui::Context);
		CHECK(!rmlui::Callbacks.RenderInterface);
		rmlui::shutdown();
		expect({"router", "textinput"});
	}
	std::cout << "PASS: production shutdown (pre-init, no-context, repeated exit, init-only rearm, two context cycles)\n";
}
