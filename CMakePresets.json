{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ABC_GAME_DIR": "$env{ABC_GAME_DIR}"
      }
    },
    {
      "name": "win32-debug",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "Win32", "strategy": "set" }
    },
    {
      "name": "win32-release",
      "inherits": "win32-debug"
    },
    {
      "name": "win32-debug-tests",
      "inherits": "win32-debug",
      "cacheVariables": {
        "ABCUI_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win32-debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug"
    },
    {
      "name": "win32-release",
      "configurePreset": "win32-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "win32-debug-tests",
      "configurePreset": "win32-debug-tests",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
